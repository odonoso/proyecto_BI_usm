  <MdxScripts>
    <MdxScript dwd:design-time-name="fac9b9cd-2838-4d39-8bf7-2fb0ea5472c1">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T03:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T03:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[Dias Despacho Prom] AS
  IIF([Measures].[Recuento Fact Detalle Venta] = 0, NULL,
      [Measures].[DIAS DESPACHO] / [Measures].[Recuento Fact Detalle Venta]),
  FORMAT_STRING = "0.0",
  VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Netas] AS
  [Measures].[MONTO TOTAL],
  FORMAT_STRING = "Currency",
  VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[% Ventas Categoria] AS
  IIF([Measures].[MONTO TOTAL] = 0, NULL,
      [Measures].[MONTO TOTAL] /
      ([Measures].[MONTO TOTAL], [Dim Producto].[CATEGORIA].[All])),
  FORMAT_STRING = "Percent",
  VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[Ranking Proveedor]
 AS Rank([Dim Producto].[NOMBRE PROVEEDOR].CurrentMember, [Dim Producto].[NOMBRE PROVEEDOR].[NOMBRE PROVEEDOR].Members, [Measures].[MONTO TOTAL]), 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="05168611-2325-4daf-8ea2-e22c6065c346">
      <ID>KPI</ID>
      <Name>ventas_netas_totales</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>sum([measures].[MONTO TOTAL])</Value>
      <Goal>1.1 * (sum([measures].[MONTO TOTAL]),
    ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
    [Fecha Orden].[Calendario].CurrentMember))</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("ventas_netas_totales")) THEN 0
  WHEN KPIValue("ventas_netas_totales") &gt;= KPIGoal("ventas_netas_totales") THEN 1
  WHEN KPIValue("ventas_netas_totales") &gt;= 0.9 * KPIGoal("ventas_netas_totales") THEN 0
  ELSE -1
END</Status>
      <Trend>IIF(IsEmpty(ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
    [Fecha Orden].[Calendario].CurrentMember)), 0,
    IIF([Measures].[Ventas Netas] &gt;
      ([Measures].[Ventas Netas],
       ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
       [Fecha Orden].[Calendario].CurrentMember)), 1, -1))</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="9b8e5ada-6245-4fa3-ab19-c26459de85e5">
      <ID>KPI 1</ID>
      <Name>concentración_por_categoría</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[measures].[% Ventas categoria]</Value>
      <Goal>0.30</Goal>
      <Status>CASE
  WHEN KPIValue("concentración_por_categoría") &gt; 0.40 THEN -1
  WHEN KPIValue("concentración_por_categoría") &gt; 0.30 THEN 0
  ELSE 1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="3bde4a6d-c465-4062-b50e-c2b72f9c2a3b">
      <ID>KPI 2</ID>
      <Name>ranking_de_proveedores</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Ranking Proveedor]</Value>
      <Goal>1</Goal>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="333f383d-53de-4523-9e47-dd4065bb18ba">
      <ID>KPI 3</ID>
      <Name>tiempo_entrega</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Dias Despacho Prom]</Value>
      <Goal>7</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("tiempo_entrega")) THEN 0
  WHEN KPIValue("tiempo_entrega") &lt;= KPIGoal("tiempo_entrega") THEN 1
  WHEN KPIValue("tiempo_entrega") &lt;= 1.25 * KPIGoal("tiempo_entrega") THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>