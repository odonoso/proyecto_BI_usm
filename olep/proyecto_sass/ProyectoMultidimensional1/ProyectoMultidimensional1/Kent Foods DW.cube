  <Source dwd:design-time-name="d572a3f5-33dc-439f-bb43-828ebac7ce68">
    <DataSourceViewID>Kent Foods DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="14ad4f3a-53de-434d-a7ed-1cddb1786a03">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/* =====================================================================
   KPIs del cubo "Kent Foods DW"
   COMO USARLO: en Visual Studio, abrir "Kent Foods DW.cube" -&gt;
   pestaña "Calculations" -&gt; boton "Script View" -&gt; BORRAR todo lo que
   haya y PEGAR este archivo completo. Guardar, Deploy y Process.
   ===================================================================== */
CALCULATE;

/* ---------- KPI 1: Ventas Netas Totales ----------
   SUM(Cantidad * PrecioUnitario * (1 - Descuento)).
   Ya viene precalculado por fila en MONTO_TOTAL (ETL). */
CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Netas Totales]
 AS [Measures].[MONTO TOTAL],
 FORMAT_STRING = "#,##0.00",
 VISIBLE = 1;

/* ---------- KPI 2: Concentracion de Ventas por Categoria (%) ----------
   Ventas del miembro actual de Producto / Ventas de TODOS los productos
   (se respeta el filtro de tiempo, cliente, etc.). */
CREATE MEMBER CURRENTCUBE.[Measures].[Concentracion Ventas %]
 AS IIF(
      [Measures].[MONTO TOTAL] = 0 OR IsEmpty([Measures].[MONTO TOTAL]),
      NULL,
      [Measures].[MONTO TOTAL] /
      ( [Measures].[MONTO TOTAL],
        [Dim Producto].[CATEGORIA].[All],
        [Dim Producto].[NOMBRE PROVEEDOR].[All],
        [Dim Producto].[PAIS PROVEEDOR].[All],
        [Dim Producto].[NOMBRE PRODUCTO].[All],
        [Dim Producto].[ID PROD].[All] )
    ),
 FORMAT_STRING = "Percent",
 VISIBLE = 1;

/* ---------- KPI 4: Tiempo Promedio de Entrega y Despacho (dias) ----------
   Suma de dias de despacho / cantidad de filas con dias de despacho
   (las ordenes SIN fecha de envio quedan con DIAS_DESPACHO = NULL, por lo
   que no cuentan; ver script 01_diagnostico_y_correccion_dw.sql).
   Usar junto a la dimension "Fecha Orden" (o Cliente/Transportista). */
CREATE MEMBER CURRENTCUBE.[Measures].[Tiempo Promedio Despacho (dias)]
 AS IIF(
      [Measures].[Recuento Dias Despacho] = 0
      OR IsEmpty([Measures].[Recuento Dias Despacho]),
      NULL,
      [Measures].[DIAS DESPACHO] / [Measures].[Recuento Dias Despacho]
    ),
 FORMAT_STRING = "#,##0.00",
 VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="7edd5a1f-1f7c-49db-a2c1-6f02a8c40e68">
      <ID>KPI</ID>
      <Name>KPI_Ventas_Netas</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Ventas Netas Totales]</Value>
      <Goal></Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("KPI_Ventas_Netas")) THEN 0
  WHEN KPIValue("KPI_Ventas_Netas") &gt;= KPIGoal("KPI_Ventas_Netas") THEN 1
  WHEN KPIValue("KPI_Ventas_Netas") &gt;= 0.9 * KPIGoal("KPI_Ventas_Netas") THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="b03c15e3-5389-4adb-9dc9-aa15087bae49">
      <ID>KPI 1</ID>
      <Name>KPI_Concentracion_Categoria</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>0.30</Value>
      <Status>CASE
  WHEN IsEmpty(KPIValue("KPI_Concentracion_Categoria")) THEN 0
  WHEN KPIValue("KPI_Concentracion_Categoria") &gt; 0.40 THEN -1
  WHEN KPIValue("KPI_Concentracion_Categoria") &gt; 0.30 THEN 0
  ELSE 1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="63e3f054-1488-4070-8385-f616febf5f87">
      <ID>KPI 2</ID>
      <Name>KPI_Tiempo_Entrega</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Tiempo Promedio Despacho (dias)]</Value>
      <Goal>7</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("KPI_Tiempo_Entrega")) THEN 0
  WHEN KPIValue("KPI_Tiempo_Entrega") &lt;= KPIGoal("KPI_Tiempo_Entrega") THEN 1
  WHEN KPIValue("KPI_Tiempo_Entrega") &lt;= 1.25 * KPIGoal("KPI_Tiempo_Entrega") THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>