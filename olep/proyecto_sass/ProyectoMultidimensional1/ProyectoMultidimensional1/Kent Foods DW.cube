  <Kpis>
    <Kpi dwd:design-time-name="0de09b87-ef78-4b1e-b524-f3d6d8164485">
      <ID>KPI</ID>
      <Name>ventas_netas_totales</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>sum([measures].[MONTO TOTAL])</Value>
      <Goal>1.1 * (sum([measures].[MONTO TOTAL]),
    ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
    [Fecha Orden].[Calendario].CurrentMember))</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("KPI Ventas Netas")) THEN 0
  WHEN KPIValue("KPI Ventas Netas") &gt;= KPIGoal("KPI Ventas Netas") THEN 1
  WHEN KPIValue("KPI Ventas Netas") &gt;= 0.9 * KPIGoal("KPI Ventas Netas") THEN 0
  ELSE -1
END</Status>
      <Trend>IIF(IsEmpty(ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
    [Fecha Orden].[Calendario].CurrentMember)), 0,
    IIF([Measures].[Ventas Netas] &gt;
      ([Measures].[Ventas Netas],
       ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
       [Fecha Orden].[Calendario].CurrentMember)), 1, -1))</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="a89ed728-fdb4-41a5-b84e-917f82b77d79">
      <ID>KPI 1</ID>
      <Name>concentración_por_categoría</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[measures].[% Ventas categoria]</Value>
      <Goal>0.30</Goal>
      <Status>CASE
  WHEN KPIValue("KPI Concentracion Categoria") &gt; 0.40 THEN -1
  WHEN KPIValue("KPI Concentracion Categoria") &gt; 0.30 THEN 0
  ELSE 1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="5dc87005-da57-4f99-89fa-ef51bca14529">
      <ID>KPI 2</ID>
      <Name>ranking_de_proveedores</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Ranking Proveedor]</Value>
      <Goal>1</Goal>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="71cc90d8-e773-45ca-bd53-5e0541d9aee6">
      <ID>KPI 3</ID>
      <Name>tiempo_entrega</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Días Despacho (prom.)]</Value>
      <Goal>7</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("KPI Tiempo Entrega")) THEN 0
  WHEN KPIValue("KPI Tiempo Entrega") &lt;= KPIGoal("KPI Tiempo Entrega") THEN 1
  WHEN KPIValue("KPI Tiempo Entrega") &lt;= 1.25 * KPIGoal("KPI Tiempo Entrega") THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>