  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="54f71fe7-662f-4039-bc8f-2e7a17c48e70">
      <ID>KPI</ID>
      <Name>ventas_netas_totales</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>-- Meta calculada como el total de ventas esperado con un 10% de crecimiento
([Measures].[MONTO TOTAL], [Fecha Orden].[Calendario].CurrentMember) * 1.10</Value>
      <Goal>1.1 * (sum([measures].[MONTO TOTAL]),
    ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
    [Fecha Orden].[Calendario].CurrentMember))</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("ventas_netas_totales")) THEN 0
  WHEN KPIValue("ventas_netas_totales") &gt;= KPIGoal("ventas_netas_totales") THEN 1
  WHEN KPIValue("ventas_netas_totales") &gt;= 0.9 * KPIGoal("ventas_netas_totales") THEN 0
  ELSE -1
END</Status>
      <Trend>IIF(IsEmpty(ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
    [Fecha Orden].[Calendario].CurrentMember)), 0,
    IIF([Measures].[Ventas Netas] &gt;
      ([Measures].[Ventas Netas],
       ParallelPeriod([Fecha Orden].[Calendario].[Año], 1,
       [Fecha Orden].[Calendario].CurrentMember)), 1, -1))</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="10ded030-9f80-4873-aa05-dc52d1b0c9d0">
      <ID>KPI 1</ID>
      <Name>concentración_por_categoría</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[measures].[% Ventas categoria]</Value>
      <Goal>0.30</Goal>
      <Status>CASE
  WHEN KPIValue("concentración_por_categoría") &gt; 0.40 THEN -1
  WHEN KPIValue("concentración_por_categoría") &gt; 0.30 THEN 0
  ELSE 1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="4cf7d98c-ba4e-4e17-b6ec-dfc2d664bb89">
      <ID>KPI 2</ID>
      <Name>ranking_de_proveedores</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Ranking Proveedor]</Value>
      <Goal>1</Goal>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="eea74a90-930e-4979-9ccb-960b54af15de">
      <ID>KPI 3</ID>
      <Name>tiempo_entrega</Name>
      <AssociatedMeasureGroupID>Fact Detalle Venta</AssociatedMeasureGroupID>
      <Value>[Measures].[Dias Despacho Prom]</Value>
      <Goal>7</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("tiempo_entrega")) THEN 0
  WHEN KPIValue("tiempo_entrega") &lt;= KPIGoal("tiempo_entrega") THEN 1
  WHEN KPIValue("tiempo_entrega") &lt;= 1.25 * KPIGoal("tiempo_entrega") THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>