  <MdxScripts>
    <MdxScript dwd:design-time-name="6025d7ae-e296-420e-aeee-bc734562754e">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T03:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T03:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CREATE MEMBER CURRENTCUBE.[Measures].[Dias Despacho Prom] AS
  IIF([Measures].[Recuento Fact Detalle Venta] = 0, NULL,
      [Measures].[DIAS DESPACHO] / [Measures].[Recuento Fact Detalle Venta]),
  FORMAT_STRING = "0.0",
  VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Netas] AS
  [Measures].[MONTO TOTAL],
  FORMAT_STRING = "Currency",
  VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[% Ventas Categoria] AS
  IIF([Measures].[MONTO TOTAL] = 0, NULL,
      [Measures].[MONTO TOTAL] /
      ([Measures].[MONTO TOTAL], [Dim Producto].[CATEGORIA].[All])),
  FORMAT_STRING = "Percent",
  VISIBLE = 1;   

CREATE MEMBER CURRENTCUBE.[Measures].[Ranking Proveedor]
 AS Rank([Dim Producto].[NOMBRE PROVEEDOR].CurrentMember, [Dim Producto].[NOMBRE PROVEEDOR].[NOMBRE PROVEEDOR].Members, [Measures].[MONTO TOTAL]), 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="72021951-2da0-4458-899a-5d1838e73684">
      <ID>KPI</ID>
      <Name>ventas_netas_totales</Name>
      <Value>[Measures].[Monto Total]</Value>
      <Goal>1.1 * ([Measures].[Monto Total], ParallelPeriod([Tiempo].[Jerarquia].[Año], 1, [Tiempo].[Jerarquia].CurrentMember))</Goal>
      <Status>CASE
  WHEN IsEmpty(KPIValue("ventas_netas_totales")) THEN 0
  WHEN KPIValue("ventas_netas_totales") &gt;= KPIGoal("ventas_netas_totales") THEN 1
  WHEN KPIValue("ventas_netas_totales") &gt;= 0.9 * KPIGoal("ventas_netas_totales") THEN 0
  ELSE -1
END</Status>
      <Trend>IIF(
  IsEmpty(ParallelPeriod([Tiempo].[Jerarquia].[Año], 1, [Tiempo].[Jerarquia].CurrentMember)), 
  0,
  IIF(
    [Measures].[Monto Total] &gt; ([Measures].[Monto Total], ParallelPeriod([Tiempo].[Jerarquia].[Año], 1, [Tiempo].[Jerarquia].CurrentMember)),
    1,
    -1
  )
)</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>