              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[Empleados]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    e.EmpleadoID AS ID_EMPLEADO,
    e.Nombre AS NOMBRE,
    e.Apellido AS APELLIDO,
    e.Cargo AS CARGO,
    e.FechaNacimiento AS FECHA_NACIMIENTO,
    e.FechaContratacion AS FECHA_CONTRATACION,
    e.Direccion AS DIRECCION,
    e.Ciudad AS CIUDAD,
    e.Pais AS PAIS,
    ISNULL(t.Territorio, 'Sin Territorio') AS TERRITORIO
FROM Empleados e
LEFT JOIN (
    SELECT EmpleadoID, MIN(TerritorioID) AS TerritorioID
    FROM TerritoriosEmpleados
    GROUP BY EmpleadoID
) te ON e.EmpleadoID = te.EmpleadoID
LEFT JOIN Territorios t ON te.TerritorioID = t.TerritorioID</property>
                <property
